# ==============================================================================
# RAG-Based-College-Knowledge-Assistant - Environment Configuration Example
# ==============================================================================
# Copy this file to .env before running locally or deploying.
# Do not commit real credentials or secrets to version control.
# ==============================================================================

# ------------------------------------------------------------------------------
# Backend Configuration (FastAPI)
# ------------------------------------------------------------------------------
PROJECT_NAME="RAG-Based-College-Knowledge-Assistant"
ENVIRONMENT=development
DEBUG=true
PORT=8000
HOST=0.0.0.0

# CORS Configuration (comma-separated origins allowed to talk to backend)
BACKEND_CORS_ORIGINS=["http://localhost:5173","http://localhost:5174"]

# Administrative Security
# Lightweight token / secret header for protecting administrative document operations
ADMIN_API_SECRET=change-me-to-a-secure-random-token-in-production

# ------------------------------------------------------------------------------
# Hosted LLM & Embeddings (Google Gemini API)
# ------------------------------------------------------------------------------
GEMINI_API_KEY=your-gemini-api-key-here
GEMINI_GENERATION_MODEL=gemini-2.5-flash
GEMINI_EMBEDDING_MODEL=text-embedding-004

# ------------------------------------------------------------------------------
# Vector Database (Qdrant Cloud)
# ------------------------------------------------------------------------------
QDRANT_URL=https://your-cluster-id.region.gcp.cloud.qdrant.io:6333
QDRANT_API_KEY=your-qdrant-cloud-api-key-here
QDRANT_COLLECTION_NAME=college_knowledge_base

# ------------------------------------------------------------------------------
# Ingestion & Chunking Defaults
# ------------------------------------------------------------------------------
CHUNK_SIZE=1000
CHUNK_OVERLAP=200
OCR_ENABLED=true
TESSERACT_CMD=tesseract

# ------------------------------------------------------------------------------
# Frontend Application Configuration
# ------------------------------------------------------------------------------
# User Chatbot application (runs by default on port 5173)
VITE_USER_API_BASE_URL=http://localhost:8000/api/v1

# Admin Panel application (runs by default on port 5174)
VITE_ADMIN_API_BASE_URL=http://localhost:8000/api/v1

