# ==============================================================================
# RAG-Based-College-Knowledge-Assistant - Environment Configuration Example
# ==============================================================================
# Copy this file to .env before running locally or deploying.
# Do not commit real credentials or secrets to version control.
# ==============================================================================

# ------------------------------------------------------------------------------
# Backend Configuration (FastAPI)
# ------------------------------------------------------------------------------
PROJECT_NAME="RAG-Based-College-Knowledge-Assistant"
ENVIRONMENT=development
DEBUG=true
PORT=8000
HOST=0.0.0.0

# CORS Configuration (comma-separated or JSON array)
BACKEND_CORS_ORIGINS=["http://localhost:5173","http://localhost:5174"]

# Administrative Security
ADMIN_API_SECRET=change-me-to-a-secure-random-token-in-production

# ------------------------------------------------------------------------------
# Relational Database (Supabase PostgreSQL Metadata Registry)
# Direct: postgresql://postgres:[PASSWORD]@db.[PROJECT_REF].supabase.co:5432/postgres
# Pooler: postgresql://postgres.[PROJECT_REF]:[PASSWORD]@aws-0-[REGION].pooler.supabase.com:6543/postgres?sslmode=require
# ------------------------------------------------------------------------------
DATABASE_URL=
DB_POOL_SIZE=5
DB_MAX_OVERFLOW=10
DB_POOL_TIMEOUT=30.0
DB_POOL_RECYCLE=1800

# Document Upload & Ingestion Constraints
MAX_UPLOAD_SIZE_BYTES=52428800
INGESTION_MAX_CONCURRENT_JOBS=10

# ------------------------------------------------------------------------------
# Hosted Embeddings (Hugging Face Inference Providers)
# Model: BAAI/bge-small-en-v1.5 (dimension: 384, task: feature-extraction)
# Free-tier serverless token: https://huggingface.co/settings/tokens
# ------------------------------------------------------------------------------
HF_TOKEN=your-huggingface-token-here
EMBEDDING_PROVIDER=huggingface
EMBEDDING_MODEL=BAAI/bge-small-en-v1.5
EMBEDDING_DIMENSION=384
EMBEDDING_BATCH_SIZE=32
EMBEDDING_TIMEOUT=30.0
EMBEDDING_MAX_RETRIES=3

# ------------------------------------------------------------------------------
# Vector Database (Qdrant Cloud)
# Free cluster: https://cloud.qdrant.io/
# ------------------------------------------------------------------------------
QDRANT_URL=https://your-cluster-id.region.gcp.cloud.qdrant.io:6333
QDRANT_API_KEY=your-qdrant-cloud-api-key-here
QDRANT_COLLECTION_NAME=college_knowledge_base
QDRANT_TIMEOUT=10.0

# ------------------------------------------------------------------------------
# Hosted LLM Generation (Google Gemini API)
# API key from Google AI Studio: https://aistudio.google.com/
# ------------------------------------------------------------------------------
GEMINI_API_KEY=your-gemini-api-key-here
GEMINI_GENERATION_MODEL=gemini-2.5-flash
GEMINI_TEMPERATURE=0.2
GEMINI_MAX_OUTPUT_TOKENS=1024
GEMINI_TIMEOUT=30.0

# ------------------------------------------------------------------------------
# Hybrid Retrieval & RRF Defaults
# ------------------------------------------------------------------------------
RETRIEVAL_DENSE_CANDIDATES=10
RETRIEVAL_KEYWORD_CANDIDATES=10
RETRIEVAL_TOP_K=5
RRF_K=60
MAX_CONTEXT_TOKENS=2000

# ------------------------------------------------------------------------------
# Ingestion & Chunking Defaults
# ------------------------------------------------------------------------------
CHUNK_SIZE=600
CHUNK_OVERLAP=100
TOKENIZER_ENCODING=cl100k_base
OCR_ENABLED=true
OCR_MIN_PAGE_CHARS=50
OCR_DPI=300
TESSERACT_CMD=tesseract

# ------------------------------------------------------------------------------
# Frontend Application Configuration
# ------------------------------------------------------------------------------
VITE_USER_API_BASE_URL=http://localhost:8000/api/v1
VITE_ADMIN_API_BASE_URL=http://localhost:8000/api/v1
