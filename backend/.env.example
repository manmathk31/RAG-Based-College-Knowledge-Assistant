# Backend Local Environment Variables
PROJECT_NAME="RAG-Based-College-Knowledge-Assistant"
ENVIRONMENT=development
DEBUG=true
PORT=8000
HOST=0.0.0.0

# CORS Allowed Origins (JSON array format)
BACKEND_CORS_ORIGINS=["http://localhost:5173","http://localhost:5174"]

# Admin Secret Protection Header
ADMIN_API_SECRET=dev-admin-secret

# Google Gemini API
GEMINI_API_KEY=your-gemini-api-key
GEMINI_GENERATION_MODEL=gemini-2.5-flash
GEMINI_EMBEDDING_MODEL=text-embedding-004

# Qdrant Cloud
QDRANT_URL=https://your-cluster.qdrant.io:6333
QDRANT_API_KEY=your-qdrant-key
QDRANT_COLLECTION_NAME=college_knowledge_base

# Ingestion Parameters
CHUNK_SIZE=1000
CHUNK_OVERLAP=200
OCR_ENABLED=true
TESSERACT_CMD=tesseract

