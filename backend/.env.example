# Backend Local Environment Variables
PROJECT_NAME="RAG-Based-College-Knowledge-Assistant"
ENVIRONMENT=development
DEBUG=true
PORT=8000
HOST=0.0.0.0

# CORS Allowed Origins (JSON array or comma-separated list)
BACKEND_CORS_ORIGINS=["http://localhost:5173","http://localhost:5174"]

# Admin Secret Protection Header
ADMIN_API_SECRET=dev-admin-secret

# ------------------------------------------------------------------------------
# Hosted Embeddings (Hugging Face Inference Providers)
# Model: BAAI/bge-small-en-v1.5 (dimension: 384, task: feature-extraction)
# Free-tier serverless token from https://huggingface.co/settings/tokens
# ------------------------------------------------------------------------------
HF_TOKEN=your-huggingface-token-here
EMBEDDING_PROVIDER=huggingface
EMBEDDING_MODEL=BAAI/bge-small-en-v1.5
EMBEDDING_DIMENSION=384
EMBEDDING_BATCH_SIZE=32
EMBEDDING_TIMEOUT=30.0
EMBEDDING_MAX_RETRIES=3

# ------------------------------------------------------------------------------
# Vector Database (Qdrant Cloud)
# Free cluster from https://cloud.qdrant.io/
# ------------------------------------------------------------------------------
QDRANT_URL=https://your-cluster-id.region.gcp.cloud.qdrant.io:6333
QDRANT_API_KEY=your-qdrant-cloud-api-key-here
QDRANT_COLLECTION_NAME=college_knowledge_base
QDRANT_TIMEOUT=10.0

# ------------------------------------------------------------------------------
# Answer Generation LLM (Google Gemini API - Planned Milestone)
# ------------------------------------------------------------------------------
GEMINI_API_KEY=your-gemini-api-key-here
GEMINI_GENERATION_MODEL=gemini-2.5-flash

# ------------------------------------------------------------------------------
# Document Extraction & OCR Defaults (Planned Milestones)
# ------------------------------------------------------------------------------
CHUNK_SIZE=1000
CHUNK_OVERLAP=200
OCR_ENABLED=true
TESSERACT_CMD=tesseract
